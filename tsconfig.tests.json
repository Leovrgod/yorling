{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "outDir": ".tmp-tests",
    "rootDir": ".",
    "strict": true,
    "noEmitOnError": true,
    "skipLibCheck": true
  },
  "include": ["tests/**/*.ts", "tests/**/*.d.ts", "src/components/keyboard/**/*.ts", "src/types/**/*.ts"]
}
