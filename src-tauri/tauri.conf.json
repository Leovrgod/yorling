{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Yorling",
  "version": "0.1.1",
  "identifier": "com.yorling.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "YORLING",
        "width": 920,
        "height": 620,
        "minWidth": 720,
        "minHeight": 500,
        "decorations": false,
        "center": true,
        "visible": false,
        "resizable": true,
        "transparent": true
      },
      {
        "label": "alt-tab-overlay",
        "title": "Yorling Alt Tab",
        "width": 1240,
        "height": 560,
        "decorations": false,
        "center": true,
        "visible": false,
        "resizable": false,
        "transparent": true
      },
      {
        "label": "bracket-overlay",
        "title": "Yorling Bracket Overlay",
        "width": 270,
        "height": 52,
        "decorations": false,
        "center": true,
        "visible": false,
        "resizable": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://gleitz.github.io https://smpldsnds.github.io; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: asset: https://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/yorling-bridge"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
